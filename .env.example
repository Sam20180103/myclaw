RUSTCLAW_HOST=127.0.0.1
RUSTCLAW_PORT=18789
RUSTCLAW_LOG_LEVEL=info

# --- BOSS 直聘 MCP server (vendor/mcp-bosszp/server.py) ---
# 短信登录手机号 (BOSS 现行登录为手机号+短信验证码)
BOSS_PHONE=
# 登录页保活秒数 (login_send_sms 与 login_submit_sms 之间), 默认 300
BOSS_LOGIN_PAGE_TTL=300
# 二维码兜底经飞书发送所需 (短信遇滑块验证时回退使用)
BOSS_FEISHU_APP_ID=
BOSS_FEISHU_APP_SECRET=
BOSS_FEISHU_CHAT_ID=

# --- 小红书 MCP server (vendor/mcp-xhs/server.py) ---
XHS_PHONE=                 # 短信登录手机号
XHS_LOGIN_PAGE_TTL=300     # 登录页保活秒数
XHS_MCP_PORT=8085          # 服务监听端口 (xhs_mcp_endpoint 默认 http://127.0.0.1:8085)

# --- 文生图 (OpenAI 兼容 /v1/images/generations); 也可写入 config.toml [tools.reach] ---
# IMAGE_GEN_BASE_URL / IMAGE_GEN_API_KEY / IMAGE_GEN_MODEL 经 config.toml 配置:
#   [tools.reach] image_gen_base_url / image_gen_api_key / image_gen_model / image_gen_output_dir

# --- 凭据 env 间接引用 (G9): 密钥不落 config.toml 明文 ---
# 在 config.toml 中把任意密钥字段写成 "env:VARNAME",启动时从环境变量解析:
#   [[providers]] api_key = "env:OPENAI_API_KEY"
#   [gateway.auth]  api_key = "env:RUSTCLAW_API_KEY"
#   [tools.reach]   exa_api_key = "env:EXA_API_KEY"   image_gen_api_key = "env:IMAGE_GEN_API_KEY"
#                   boss_cookie = "env:BOSS_COOKIE"    xhs_cookie = "env:XHS_COOKIE"
#   [channels.feishu] app_secret = "env:FEISHU_APP_SECRET"
#   [channels.wechat] send_token = "env:WECHAT_SEND_TOKEN"
# 缺失 env 时: 可选字段置空; 必填字段保留字面量并告警。
OPENAI_API_KEY=
RUSTCLAW_API_KEY=
EXA_API_KEY=

# --- Profile 隔离 (G7): 多角色/多租户数据分离 ---
# 设置后 config/skills/logs/数据目录变为 .../profiles/<name>/;不设或 default = 旧路径
RUSTCLAW_PROFILE=

# --- 沙箱执行后端 (G5): local | docker:IMAGE | docker+net:IMAGE ---
RUSTCLAW_SANDBOX_BACKEND=local

# --- 定时任务 (G8) 经 config.toml 配置,例:
#   [[schedules]]
#   name = "morning-hot"
#   every = "12h"          # 30s/10m/2h/1d, 最小 10s
#   prompt = "查看小红书热门 Top10 并总结"
#   # enabled = true       # 默认
#   # session_key = "..."  # 默认 schedule:<name>
